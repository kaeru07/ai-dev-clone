@echo off
cd /d "%~dp0"
chcp 932 > nul
setlocal enabledelayedexpansion

REM ????Z?b?g?A?b?v?`?F?b?N
set SETUP_COMPLETE_FILE=%~dp0.setup_complete
set IS_FIRST_SETUP=0

if not exist "%SETUP_COMPLETE_FILE%" (
    set IS_FIRST_SETUP=1
    echo ===============================
    echo ????Z?b?g?A?b?v??J?n?????
    echo ===============================
    echo.
)

REM Node.js?????`?F?b?N
where node >nul 2>&1
if %errorlevel% neq 0 (
    echo ===============================
    echo Node.js?????????????
    echo ===============================
    echo.
    echo Node.js??C???X?g?[???????...
    echo.
    
    REM Node.js?C???X?g?[???[??_?E?????[?h
    echo [1/3] Node.js?C???X?g?[???[??_?E?????[?h??...
    powershell -Command "& {[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $url='https://nodejs.org/dist/v20.11.0/node-v20.11.0-x64.msi'; $output='%TEMP%\nodejs-installer.msi'; Invoke-WebRequest -Uri $url -OutFile $output; if (Test-Path $output) {Write-Host '?_?E?????[?h????'} else {Write-Host '?_?E?????[?h???s'; exit 1}}"
    
    if %errorlevel% neq 0 (
        echo.
        echo ?_?E?????[?h????s????????B
        echo ??@??C???X?g?[?????????????: https://nodejs.org/
        pause
        exit /b 1
    )
    
    REM Node.js??C???X?g?[?????s
    echo.
    echo [2/3] Node.js??C???X?g?[????...
    echo ?C???X?g?[???E?B?U?[?h???J??????B????w????]????????????B
    echo.
    msiexec /i "%TEMP%\nodejs-installer.msi" /qb
    
    REM ?C???X?g?[????????@
    echo.
    echo [3/3] ?C???X?g?[????????????????...
    timeout /t 10 /nobreak >nul
    
    REM ??????????????
    call refreshenv >nul 2>&1
    
    REM ??x?`?F?b?N
    where node >nul 2>&1
    if %errorlevel% neq 0 (
        echo.
        echo Node.js??C???X?g?[????????????????????B
        echo PC???N?????????A?????x????o?b?`?t?@?C??????s????????????B
        echo.
        echo ?????A??@??C???X?g?[?????????????: https://nodejs.org/
        pause
        exit /b 1
    )
    
    echo.
    echo Node.js??C???X?g?[????????????????I
    echo.
    
    REM npm?p?b?P?[?W??C???X?g?[??
    echo ?K?v??p?b?P?[?W??C???X?g?[???????...
    call npm install
    
    if %errorlevel% neq 0 (
        echo.
        echo ?p?b?P?[?W??C???X?g?[??????s????????B
        echo ????R?}???h???@????s???????????:
        echo   cd "%~dp0"
        echo   npm install
        echo   npx playwright install chromium
        pause
        exit /b 1
    )
    
    echo.
    echo Playwright?u???E?U??C???X?g?[???????...
    call npx playwright install chromium
    
    if %errorlevel% neq 0 (
        echo.
        echo Playwright??C???X?g?[??????s????????B
        echo ????R?}???h???@????s???????????:
        echo   npx playwright install chromium
        pause
        exit /b 1
    )
    
    echo.
    echo ========================================
    echo ?Z?b?g?A?b?v??????????????I
    echo ========================================
    echo.
    timeout /t 3 /nobreak >nul
)

REM node_modules?t?H???_?????`?F?b?N
if not exist "%~dp0node_modules" (
    echo ===============================
    echo ?p?b?P?[?W??C???X?g?[????...
    echo ===============================
    echo.
    
    call npm install
    
    if %errorlevel% neq 0 (
        echo.
        echo ?p?b?P?[?W??C???X?g?[??????s????????B
        echo ????R?}???h???@????s???????????:
        echo   cd "%~dp0"
        echo   npm install
        echo   npx playwright install chromium
        pause
        exit /b 1
    )
    
    echo.
    echo Playwright?u???E?U??C???X?g?[???????...
    call npx playwright install chromium
    
    if %errorlevel% neq 0 (
        echo.
        echo Playwright??C???X?g?[??????s????????B
        echo ????R?}???h???@????s???????????:
        echo   npx playwright install chromium
        pause
        exit /b 1
    )
    
    echo.
    echo ========================================
    echo ?p?b?P?[?W??C???X?g?[????????????????I
    echo ========================================
