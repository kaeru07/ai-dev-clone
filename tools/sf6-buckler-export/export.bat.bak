    timeout /t 3 /nobreak >nul
)

REM SID???i??????j
if %IS_FIRST_SETUP%==1 (
    echo.
    echo ===============================
    echo ???????SID?????????????
    echo ===============================
    echo.
    echo SID?? Buckler ??v???t?B?[??URL??????\??????B
    echo ??: https://www.streetfighter.com/6/buckler/ja-jp/profile/1146188535/...
    echo     ??????ASID??u1146188535?v????B
    echo.
    set /p USER_SID="SID???????????????: "
    
    if "!USER_SID!"=="" (
        echo.
        echo ?G???[: SID????????????????B
        pause
        exit /b 1
    )
    
    echo.
    echo SID????: !USER_SID!
    
    REM PowerShell?X?N???v?g??SID????
    powershell -ExecutionPolicy Bypass -File "%~dp0update_sid.ps1" -SID "!USER_SID!"
    
    if %errorlevel% neq 0 (
        echo.
        echo ?G???[: SID???????s????????B
        pause
        exit /b 1
    )
    
    echo.
    
    REM ?Z?b?g?A?b?v?????t???O???
    echo setup_completed > "%SETUP_COMPLETE_FILE%"
)

echo ===============================
echo Buckler BattleLog -^> CSV
echo ===============================
echo.
echo Node.js ?o?[?W????:
node --version
echo.
echo ====================================
echo ???????
echo ====================================
echo 1) ?u???E?U??Buckler????O?C??
echo 2) ?o?g?????O(?????N?})??????????????
echo 3) ?N?b?L?[?????????????u????v??I??
echo.
echo ????????????? Enter ??????????????
pause > nul
node "%~dp0src\export_buckler_auto.js"

if errorlevel 1 (
  echo.
  echo ?G???[???~????????B?????O??m?F????????????B
  pause
  exit /b 1
)

echo.
echo ?????Bbattlelog.csv ??m?F????????????B
